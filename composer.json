{
    "name": "minhphi2302/sport-shoes-website",
    "description": "Website bán giày thể thao MVC thuần",
    "type": "project",
    "require": {
        "php": "^8.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "format": "php-cs-fixer fix app/",
        "test": "phpunit"
    },
    "config": {
        "disable-tls": true
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "http://packagist.org"
        }
    }
}
